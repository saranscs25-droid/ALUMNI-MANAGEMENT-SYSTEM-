private void save(boolean insert) {
    String n = name.getText().trim();
    String d = String.valueOf(dept.getSelectedItem()).trim();
    String m = email.getText().trim();
    int b;
    if (n.isEmpty() || d.isEmpty()) {
        Theme.say(status,"Name and department are required",false);
        return;
    }
    try {
        b = Integer.parseInt(batch.getText().trim());
    } catch (NumberFormatException ex) {
        Theme.say(status,"Batch must be a year such as 2021",false);
        return;
    }
    if (!m.isEmpty() && !m.matches("[\\w.+-]+@[\\w-]+(\\.[\\w-]+)+")) {
        Theme.say(status, "Enter a valid email address", false);
        return;
    }
    try {
        if (insert) {
            Db.run(
                "INSERT INTO alumni(name,batch,department,email,company,job_role) VALUES (?,?,?,?,?,?)",
                n, b, d, m,
                company.getText().trim(),
                role.getText().trim()
            );
        } else {
            int r = table.getSelectedRow();
            if (r < 0) {
                Theme.say(status, "Select a row to update", false);
                return;
            }
            Db.run(
                "UPDATE alumni SET name=?,batch=?,department=?,email=?,company=?,job_role=? WHERE alumni_id=?",
                n, b, d, m,
                company.getText().trim(),
                role.getText().trim(),
                model.getValueAt(table.convertRowIndexToModel(r), 0)
            );
        }
        load();
        clear();
        Theme.say(status, insert ? "Alumnus added" : "Record updated",true);
    } catch (SQLException ex) {
        Theme.err(this, ex);
    }
}
private void delete() {
    int r = table.getSelectedRow();
    if (r < 0) {
        Theme.say(status, "Select a row to delete", false);
        return;
    }
    r = table.convertRowIndexToModel(r);
    if (JOptionPane.showConfirmDialog(
            this,
            "Delete " + cell(r, 1) + "?",
            "Confirm",
            JOptionPane.YES_NO_OPTION
        ) != JOptionPane.YES_OPTION) {
        return;
    }
    try {
        Db.run(
            "DELETE FROM alumni WHERE alumni_id=?",
            model.getValueAt(r, 0)
        );
        load();
        clear();
        Theme.say(status, "Record deleted", true);
    } catch (SQLException ex) {
        Theme.err(this, ex);
    }
}
private void addEvent() {
    if (name.getText().trim().isEmpty() || venue.getText().trim().isEmpty()) {
        Theme.say(status, "Event name and venue are required",false);
        return;
    }
    try {
        Db.run(
            "INSERT INTO events(event_name,event_date,venue) VALUES (?,?,?)",
            name.getText().trim(),
            Date.valueOf(date.getText().trim()),
            venue.getText().trim()
        );
        name.setText("");
        date.setText("");
        venue.setText("");
        loadEvents();
        Theme.say(status, "Event created", true);
    } catch (IllegalArgumentException ex) {
        Theme.say(
            status,
            "Type the date as yyyy-mm-dd",
            false
        );
    } catch (SQLException ex) {
        Theme.err(this, ex);
    }
}

private void register() {
    int ev = selectedEvent();
    if (ev < 0 || alumniBox.getSelectedItem() == null) {
        Theme.say(status, "Select an event and an alumnus",false);
        return;
    }
    int alumniId = Integer.parseInt(
        alumniBox.getSelectedItem().toString().split(" - ")[0]
    );
    try {
        Db.run(
            "INSERT INTO registrations(alumni_id,event_id) VALUES (?,?)",
            alumniId, ev
        );
        showRegistrations();
        Theme.say(status, "Registered successfully", true);
    } catch (SQLIntegrityConstraintViolationException ex) {
        Theme.say(status, "That alumnus is already registered", false);
    } catch (SQLException ex) {
        Theme.err(this, ex);
    }
}
private void showRegistrations() {
    int ev = selectedEvent();
    if (ev < 0)
        return;
    try {
        regModel.setRowCount(0);

        for (Object[] r : Db.rows(
                "SELECT a.alumni_id,a.name,a.batch,a.department "
                + "FROM registrations r "
                + "JOIN alumni a ON a.alumni_id=r.alumni_id "
                + "WHERE r.event_id=? ORDER BY a.name",
                ev)) {
            regModel.addRow(r);
        }
    } catch (SQLException ex) {
        Theme.err(this, ex);
    }
}
