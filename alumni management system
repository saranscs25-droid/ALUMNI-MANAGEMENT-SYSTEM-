        go.addActionListener(e -> signIn());
        getRootPane().setDefaultButton(go);
        setSize(820, 480);
        setResizable(false);
        setLocationRelativeTo(null);
        setDefaultCloseOperation(EXIT_ON_CLOSE);
    }
    private void signIn() {
        try {
            if (Db.login(user.getText().trim(), new String(pass.getPassword()))) {
                new Shell().setVisible(true);
                dispose();
            } else {
                Theme.say(
                    msg,
                    "Incorrect username or password",
                    false
                );
            }
        } catch (SQLException ex) {
            Theme.say(msg,"Cannot reach database - check Db.java",false);
        }
    }

