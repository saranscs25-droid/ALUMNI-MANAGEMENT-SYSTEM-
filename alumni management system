CREATE DATABASE IF NOT EXISTS alumni_db;
USE alumni_db;
CREATE TABLE admin (
    admin_id INT PRIMARY KEY AUTO_INCREMENT,
    username VARCHAR(50) NOT NULL UNIQUE,
    password CHAR(64) NOT NULL
);
CREATE TABLE alumni (
    alumni_id INT PRIMARY KEY AUTO_INCREMENT,
    name VARCHAR(100) NOT NULL,
    batch INT NOT NULL,
    department VARCHAR(50) NOT NULL,
    email VARCHAR(100),
    company VARCHAR(100),
    job_role VARCHAR(100)
);
CREATE TABLE events (
    event_id INT PRIMARY KEY AUTO_INCREMENT,
    event_name VARCHAR(100) NOT NULL,
    event_date DATE NOT NULL,
    venue VARCHAR(100) NOT NULL
);
CREATE TABLE registrations (
    reg_id INT PRIMARY KEY AUTO_INCREMENT,
    alumni_id INT NOT NULL,
    event_id INT NOT NULL,
    UNIQUE (alumni_id, event_id),
    FOREIGN KEY (alumni_id)
        REFERENCES alumni(alumni_id) ON DELETE CASCADE,
    FOREIGN KEY (event_id)
        REFERENCES events(event_id) ON DELETE CASCADE
);
public final class Db {
    private static final String URL =
“jdbc:mysql://localhost:3306/alumni_db?useSSL=false&serverTimezone=UTC";
    private static final String USER = "root";
    private static final String PASS = "password";
    public static Connection open() throws SQLException {
        return DriverManager.getConnection(URL, USER, PASS);
    }
    public static List<Object[]> rows(String sql, Object... args) throws SQLException {
        try (Connection c = open();PreparedStatement ps = c.prepareStatement(sql)) {
            for (int i = 0; i < args.length; i++)
                ps.setObject(i + 1, args[i]);
            try (ResultSet rs = ps.executeQuery()) {
                int n = rs.getMetaData().getColumnCount();
                List<Object[]> out = new ArrayList<>();
                while (rs.next()) {
                    Object[] r = new Object[n];
                    for (int i = 0; i < n; i++)
                        r[i] = rs.getObject(i + 1);
                    out.add(r);
                }
                return out;
            }
        }
    }

    public static int run(String sql, Object... args) throws SQLException {
        try (Connection c = open();
PreparedStatement ps = c.prepareStatement(sql)) {
            for (int i = 0; i < args.length; i++)
                ps.setObject(i + 1, args[i]);
            return ps.executeUpdate();
        }
    }
    public static long one(String sql) throws SQLException {
        return ((Number) rows(sql).get(0)[0]).longValue();
    }
    public static boolean login(String user, String pass) throws SQLException {
        return !rows(
            "SELECT 1 FROM admin WHERE username=? AND password=SHA2(?,256)",
            user, pass
        ).isEmpty();
    }
}
